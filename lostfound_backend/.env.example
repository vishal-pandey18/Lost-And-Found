# Copy to .env and fill in real values.
# NOTE: Spring Boot does not read .env automatically - either export these
# into your shell, or set them in your IDE run configuration.
#
# PowerShell:  $env:DB_URL="..."
# bash/zsh:    export $(cat .env | xargs)

DB_URL=jdbc:postgresql://<your-neon-host>/<dbname>?sslmode=require
DB_USERNAME=<your-db-username>
DB_PASSWORD=<your-db-password>

JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ACCESS_EXP=900000
JWT_REFRESH_EXP=604800000

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=15

PORT=8080
